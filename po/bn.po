msgstr "লাইসেন্স AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/iconlib.py:167
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "এটি মুক্ত সফটওয়্যার: আপনি এটি পরিবর্তন ও পুনর্বণ্টন করতে পারেন।\n"

#: src/iconlib.py:168
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "এই প্রকল্প এআই শোষণ ও এআই আধিপত্যের বিরোধিতা করে।\n"

#: src/iconlib.py:171
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "এই প্রকল্প নির্বোধ MIT-শৈলীর লাইসেন্সিং এবং রাজনৈতিকভাবে নিষ্পাপ BSD-শৈলীর লাইসেন্সিং প্রত্যাখ্যান করে।\n"

#: src/iconlib.py:175
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "আইন অনুমোদিত সীমায় কোনো ওয়ারেন্টি নেই।\n"

#: src/iconlib.py:355
#, python-brace-format
msgid "Copied {n} file(s) into {dir}"
msgstr "{dir}-এ {n}টি ফাইল অনুলিপি করা হয়েছে"
