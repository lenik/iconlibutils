#: src/iconlib.py:31
msgid ""
"Commands:\n"
"  search [pattern]   list matching icon names\n"
"  which [-a] name    print icon path(s)\n"
"  info name          print icon metadata\n"
"  pull [pattern]     copy icons into the project\n"
"  push [pattern]     upload icons (not implemented)\n"
"  browse [pattern]   open themestylebrowser\n"
"\n"
"Pattern: empty=all, exact name, glob, or /regex\n"
"Plain English words also match synonyms/inflections (scored).\n"
msgstr ""
"কমান্ডসমূহ:\n"
"  search [pattern]   মিলে যাওয়া আইকন নাম তালিকা\n"
"  which [-a] name    আইকনের পথ মুদ্রণ\n"
"  info name          আইকন মেটাডেটা মুদ্রণ\n"
"  pull [pattern]     প্রকল্পে আইকন অনুলিপি\n"
"  push [pattern]     আইকন আপলোড (বাস্তবায়িত নয়)\n"
"  browse [pattern]   themestylebrowser খুলুন\n"
"\n"
"প্যাটার্ন: খালি=সব, সঠিক নাম, glob, বা /regex\n"
"সাধারণ ইংরেজি শব্দ প্রতিশব্দ/রূপভেদও মিলায় (স্কোরসহ)।\n"

#: src/iconlib.py:47
msgid "Search and manage icons from installed icon libraries."
msgstr "ইনস্টল করা আইকন লাইব্রেরি থেকে আইকন অনুসন্ধান ও পরিচালনা।"

#: src/iconlib.py:57
msgid "add/restrict icon library (repeatable; prefix match)"
msgstr "আইকন লাইব্রেরি যোগ/সীমাবদ্ধ করুন (পুনরাবৃত্তিযোগ্য; উপসর্গ মিল)"

#: src/iconlib.py:64
msgid "local assets directory for pull (relative to project-dir)"
msgstr "pull-এর জন্য স্থানীয় অ্যাসেট ডিরেক্টরি (project-dir আপেক্ষিক)"

#: src/iconlib.py:71
msgid "pull path schema (e.g. n, l/f/n, l/v/n)"
msgstr "pull পথ স্কিমা (যেমন n, l/f/n, l/v/n)"

#: src/iconlib.py:80
msgid "map library name to local dirname"
msgstr "লাইব্রেরি নামকে স্থানীয় ডিরেক্টরি নামে ম্যাপ করুন"

#: src/iconlib.py:87
msgid "repeat for more verbose loggings"
msgstr "আরও বিস্তারিত লগের জন্য পুনরাবৃত্তি করুন"

#: src/iconlib.py:93
msgid "show less logging messages"
msgstr "কম লগ বার্তা দেখান"

#: src/iconlib.py:98
msgid "output version information and exit"
msgstr "সংস্করণ তথ্য আউটপুট করে প্রস্থান"

#: src/iconlib.py:103
msgid "find icons matching the query"
msgstr "প্রশ্নের সাথে মিলে যাওয়া আইকন খুঁজুন"

#: src/iconlib.py:109
msgid "long format including score"
msgstr "স্কোরসহ দীর্ঘ বিন্যাস"

#: src/iconlib.py:115
msgid "output names only (default)"
msgstr "শুধু নাম আউটপুট (ডিফল্ট)"

#: src/iconlib.py:119
msgid "print icon paths for the name"
msgstr "নামের জন্য আইকন পথ মুদ্রণ"

#: src/iconlib.py:124
msgid "print all matching paths"
msgstr "সব মিলে যাওয়া পথ মুদ্রণ"

#: src/iconlib.py:128
msgid "print icon info"
msgstr "আইকন তথ্য মুদ্রণ"

#: src/iconlib.py:131
msgid "retrieve icons to the project"
msgstr "প্রকল্পে আইকন আনুন"

#: src/iconlib.py:139
msgid "add a format (repeatable); default all"
msgstr "একটি বিন্যাস যোগ করুন (পুনরাবৃত্তিযোগ্য); ডিফল্ট সব"

#: src/iconlib.py:148
msgid "add an image size or alias=size (repeatable)"
msgstr "ছবির আকার বা alias=size যোগ করুন (পুনরাবৃত্তিযোগ্য)"

#: src/iconlib.py:152
msgid "upload icons to a remote library"
msgstr "দূরবর্তী লাইব্রেরিতে আইকন আপলোড"

#: src/iconlib.py:155
msgid "browse with themestylebrowser"
msgstr "themestylebrowser দিয়ে ব্রাউজ"

