msgstr "schema del percorso per pull (es. n, l/f/n, l/v/n)"

#: src/iconlib.py:80
msgid "map library name to local dirname"
msgstr "mappa il nome della libreria a una directory locale"

#: src/iconlib.py:87
msgid "repeat for more verbose loggings"
msgstr "ripetere per registrazioni piu dettagliate"

#: src/iconlib.py:93
msgid "show less logging messages"
msgstr "mostra meno messaggi di registro"

#: src/iconlib.py:98
