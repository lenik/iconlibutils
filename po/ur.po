msgstr "پھیلانے کے لیے مقامی آئیکن نام"

#: src/iconlib/cmd/make.py:166
#, python-brace-format
msgid "Made {n} local variant file(s)"
msgstr "{n} مقامی قسم فائل(یں) بنیں"
