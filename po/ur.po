msgstr "دور دراز لائبریری میں آئیکن اپ لوڈ کریں"

#: src/iconlib/cmd/browse.py:18
msgid "browse with themestylebrowser"
msgstr "themestylebrowser سے براؤز کریں"

#: src/iconlib/cmd/libraries.py:18
msgid "list discovered icon libraries"
msgstr "دریافت شدہ آئیکن لائبریریاں فہرست کریں"

#: src/iconlib/cmd/libraries.py:24
msgid "show path, title, license, homepage"
msgstr "راستہ، عنوان، لائسنس، ہوم پیج دکھائیں"

#: src/iconlib/cmd/libraries.py:30
msgid "print library names only"
msgstr "صرف لائبریری نام چھاپیں"

#: src/iconlib/cmd/index.py:115
msgid "generate web preview and/or FAISS index"
msgstr "ویب پیش منظر اور/یا FAISS اشاریہ بنائیں"

#: src/iconlib/cmd/index.py:121
msgid "create web preview (default when neither -w nor -F is given)"
msgstr "ویب پیش منظر بنائیں (-w یا -F نہ ہو تو طے شدہ)"

#: src/iconlib/cmd/index.py:127
msgid "create FAISS index (faiss.index / faiss.map / faiss.json)"
msgstr "FAISS اشاریہ بنائیں (faiss.index / faiss.map / faiss.json)"

#: src/iconlib/cmd/index.py:133
msgid "overwrite existing outputs"
msgstr "موجودہ آؤٹ پٹ پر لکھیں"

#: src/iconlib/cmd/index.py:140
