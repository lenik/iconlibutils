msgstr "CLIP سے پہلے FAISS کینوس سائز (طے شدہ: 300x300)"

#: src/iconlib/cmd/index.py:147
msgid "output directory (default: .)"
msgstr "آؤٹ پٹ ڈائریکٹری (طے شدہ: .)"

#: src/iconlib/cmd/index.py:153
msgid "library id embedded in the web page (default: first -l or basename)"
msgstr "صفحے میں شامل لائبریری آئی ڈی (طے شدہ: پہلا -l یا basename)"

#: src/iconlib/cmd/index.py:159
msgid "web preview display title"
msgstr "ویب پیش منظر ڈسپلے عنوان"

#: src/iconlib/cmd/index.py:165
