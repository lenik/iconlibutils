#: src/iconlib/cmd/main.py:48
msgid ""
"Commands:\n"
"  search [pattern]   list matching icon names\n"
"  which [-a] name    print icon path(s)\n"
"  info name          print icon metadata\n"
"  libraries          list discovered icon libraries\n"
"  pull [pattern]     copy icons into the project\n"
"  push [pattern]     upload icons (not implemented)\n"
"  browse [pattern]   open themestylebrowser\n"
"  index              generate web preview and/or FAISS index\n"
"  delete name...     remove local icon files\n"
"  rename old new     rename local icon files\n"
"  copy from to       copy local icon files\n"
"  ln [-sf] tgt name  link local icon files\n"
"  make [-s SIZE] [-F FMT] name...  derive local variants\n"
"\n"
"Pattern: empty=all, exact name, glob, or /regex\n"
"Plain English words also match synonyms/inflections (scored).\n"
"Local commands operate under project-dir/local-dir (default: icons/).\n"
msgstr ""
"احکامات:\n"
"  search [pattern]   مماثل آئیکن ناموں کی فہرست\n"
"  which [-a] name    آئیکن کا راستہ چھاپیں\n"
"  info name          آئیکن میٹا ڈیٹا چھاپیں\n"
"  libraries          دریافت شدہ آئیکن لائبریریاں\n"
"  pull [pattern]     پروجیکٹ میں آئیکن کاپی کریں\n"
"  push [pattern]     اپ لوڈ (غیر نافذ)\n"
"  browse [pattern]   themestylebrowser کھولیں\n"
"  index              ویب پیش منظر اور/یا FAISS اشاریہ بنائیں\n"
"  delete name...     مقامی آئیکن فائلیں حذف کریں\n"
"  rename old new     مقامی آئیکن کا نام بدلیں\n"
"  copy from to       مقامی آئیکن کاپی کریں\n"
"  ln [-sf] tgt name  مقامی آئیکن لنک کریں\n"
"  make [-s SIZE] [-F FMT] name...  مقامی اقسام بنائیں\n"
"\n"
"پیٹرن: خالی=سب، درست نام، glob، یا /ریجیکس\n"
"سادہ انگریزی الفاظ مترادفات/صرف سے بھی ملتے ہیں (اسکور کے ساتھ)۔\n"
"مقامی احکامات project-dir/local-dir پر چلتے ہیں (طے شدہ: icons/)۔\n"

#: src/iconlib/cmd/main.py:72
msgid "Search and manage icons from installed icon libraries."
msgstr "نصب شدہ آئیکن لائبریریوں سے آئیکن تلاش اور منظم کریں۔"

#: src/iconlib/cmd/main.py:82
msgid "add/restrict icon library (repeatable; prefix match)"
msgstr "آئیکن لائبریری شامل/محدود کریں (دہرایا جا سکتا؛ سابقہ مماثلت)"

#: src/iconlib/cmd/main.py:89
msgid "local assets directory for pull (relative to project-dir)"
msgstr "pull کے لیے مقامی اثاثہ ڈائریکٹری (project-dir کے نسبت)"

#: src/iconlib/cmd/main.py:96
msgid "pull path schema (e.g. n, l/f/n, l/v/n)"
msgstr "pull راستہ اسکیمہ (مثلاً n، l/f/n، l/v/n)"

#: src/iconlib/cmd/main.py:105
msgid "map library name to local dirname"
msgstr "لائبریری نام کو مقامی ڈائریکٹری نام سے منسلک کریں"

#: src/iconlib/cmd/main.py:112
msgid "repeat for more verbose loggings"
msgstr "زیادہ تفصیلی لاگ کے لیے دہرائیں"

#: src/iconlib/cmd/main.py:118
msgid "show less logging messages"
msgstr "کم لاگ پیغامات دکھائیں"

#: src/iconlib/cmd/main.py:123
msgid "output version information and exit"
msgstr "ورژن معلومات دکھا کر باہر نکلیں"

#: src/iconlib/cmd/main.py:136
#, python-brace-format
msgid "Copyright (C) {year} {author}\n"
msgstr "کاپی رائٹ (C) {year} {author}\n"

#: src/iconlib/cmd/main.py:138
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "لائسنس AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/iconlib/cmd/main.py:140
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "یہ آزاد سافٹ ویئر ہے: آپ اسے تبدیل اور دوبارہ تقسیم کر سکتے ہیں۔\n"

#: src/iconlib/cmd/main.py:141
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "یہ منصوبہ اے آئی استحصال اور اے آئی غلبے کی مخالفت کرتا ہے۔\n"

#: src/iconlib/cmd/main.py:144
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "یہ منصوبہ بے سوچے سمجھے MIT طرز لائسنسنگ اور سیاسی طور پر سادہ لوح BSD طرز لائسنسنگ مسترد کرتا ہے۔\n"

#: src/iconlib/cmd/main.py:148
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "قانون کی اجازت کی حد تک کوئی ضمانت نہیں۔\n"

#: src/iconlib/cmd/search.py:13
msgid "find icons matching the query"
msgstr "استفسار سے مماثل آئیکن تلاش کریں"

#: src/iconlib/cmd/search.py:19
msgid "long format including score"
msgstr "اسکور سمیت طویل طرز"

#: src/iconlib/cmd/search.py:25
msgid "output names only (default)"
msgstr "صرف نام دکھائیں (ڈیفالٹ)"

#: src/iconlib/cmd/which.py:16
msgid "print icon paths for the name"
msgstr "نام کے لیے آئیکن راستے چھاپیں"

#: src/iconlib/cmd/which.py:21
msgid "print all matching paths"
msgstr "تمام مماثل راستے چھاپیں"

#: src/iconlib/cmd/info.py:16
msgid "print icon info"
msgstr "آئیکن معلومات چھاپیں"

#: src/iconlib/cmd/pull.py:109
msgid "retrieve icons to the project"
msgstr "پروجیکٹ میں آئیکن لائیں"

#: src/iconlib/cmd/pull.py:117
msgid "add a format (repeatable); default all"
msgstr "ایک طرز شامل کریں (دہرایا جا سکتا)؛ ڈیفالٹ سب"

#: src/iconlib/cmd/pull.py:126
msgid "add an image size or alias=size (repeatable)"
msgstr "تصویر کا سائز یا alias=size شامل کریں (دہرایا جا سکتا)"

#: src/iconlib/cmd/pull.py:177
#, python-brace-format
msgid "Copied {n} file(s) into {dir}"
msgstr "{dir} میں {n} فائل(یں) کاپی ہو گئیں"

#: src/iconlib/cmd/push.py:13
