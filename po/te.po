msgstr "pull మార్గ పథకం (ఉదా. n, l/f/n, l/v/n)"

#: src/iconlib/cmd/main.py:105
msgid "map library name to local dirname"
msgstr "లైబ్రరీ పేరును స్థానిక డైరెక్టరీ పేరుకు మ్యాప్ చేయి"

#: src/iconlib/cmd/main.py:112
msgid "repeat for more verbose loggings"
msgstr "మరిన్ని వివరమైన లాగ్‌ల కోసం పునరావృతం చేయి"

#: src/iconlib/cmd/main.py:118
msgid "show less logging messages"
msgstr "తక్కువ లాగ్ సందేశాలను చూపు"

#: src/iconlib/cmd/main.py:123
msgid "output version information and exit"
msgstr "వెర్షన్ సమాచారం ముద్రించి నిష్క్రమించు"

#: src/iconlib/cmd/main.py:136
#, python-brace-format
msgid "Copyright (C) {year} {author}\n"
msgstr "కాపీరైట్ (C) {year} {author}\n"

#: src/iconlib/cmd/main.py:138
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "లైసెన్స్ AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/iconlib/cmd/main.py:140
msgid "This is free software: you are free to change and redistribute it.\n"
