msgstr "打印图标信息"

#: src/iconlib.py:131
msgid "retrieve icons to the project"
msgstr "将图标取回到项目"

#: src/iconlib.py:139
msgid "add a format (repeatable); default all"
msgstr "添加一种格式（可重复）；默认全部"

#: src/iconlib.py:148
msgid "add an image size or alias=size (repeatable)"
msgstr "添加图像尺寸或 alias=size（可重复）"

#: src/iconlib.py:152
