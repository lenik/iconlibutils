#: src/iconlib.py:31
msgid ""
"Commands:\n"
"  search [pattern]   list matching icon names\n"
"  which [-a] name    print icon path(s)\n"
"  info name          print icon metadata\n"
"  pull [pattern]     copy icons into the project\n"
"  push [pattern]     upload icons (not implemented)\n"
"  browse [pattern]   open themestylebrowser\n"
"\n"
"Pattern: empty=all, exact name, glob, or /regex\n"
"Plain English words also match synonyms/inflections (scored).\n"
msgstr ""
"Kommandon:\n"
"  search [pattern]   lista matchande ikonnamn\n"
"  which [-a] name    skriv ut ikonens soekvaeg(ar)\n"
"  info name          skriv ut ikonmetadata\n"
"  pull [pattern]     kopiera ikoner till projektet\n"
"  push [pattern]     ladda upp ikoner (ej implementerat)\n"
"  browse [pattern]   oeppna themestylebrowser\n"
"\n"
"Moenster: tomt=alla, exakt namn, glob eller /regex\n"
"Vanliga engelska ord matchar aeven synonymer/boejningar (med poaeng).\n"

#: src/iconlib.py:47
