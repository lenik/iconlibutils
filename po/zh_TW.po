msgstr "輸出版本資訊並結束"

#: src/iconlib.py:103
msgid "find icons matching the query"
msgstr "尋找符合查詢的圖示"

#: src/iconlib.py:109
msgid "long format including score"
msgstr "包含分數的長格式"

#: src/iconlib.py:115
msgid "output names only (default)"
msgstr "僅輸出名稱（預設）"

#: src/iconlib.py:119
msgid "print icon paths for the name"
msgstr "列印該名稱的圖示路徑"

#: src/iconlib.py:124
msgid "print all matching paths"
msgstr "列印所有相符路徑"

#: src/iconlib.py:128
msgid "print icon info"
