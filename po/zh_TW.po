#: src/iconlib.py:131
msgid "retrieve icons to the project"
msgstr "將圖示取回專案"

#: src/iconlib.py:139
msgid "add a format (repeatable); default all"
msgstr "新增一種格式（可重複）；預設全部"

#: src/iconlib.py:148
msgid "add an image size or alias=size (repeatable)"
msgstr "新增影像尺寸或 alias=size（可重複）"

#: src/iconlib.py:152
msgid "upload icons to a remote library"
msgstr "將圖示上傳到遠端函式庫"

#: src/iconlib.py:155
msgid "browse with themestylebrowser"
msgstr "使用 themestylebrowser 瀏覽"

