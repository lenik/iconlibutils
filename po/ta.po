#: src/iconlib.py:175
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "சட்டம் அனுமதிக்கும் அளவில் எந்த உத்தரவாதமும் இல்லை.\n"

#: src/iconlib.py:355
#, python-brace-format
msgid "Copied {n} file(s) into {dir}"
msgstr "{dir}-இல் {n} கோப்பு(கள்) நகலெடுக்கப்பட்டன"
