#: src/iconlib/cmd/browse.py:18
msgid "browse with themestylebrowser"
msgstr "themestylebrowser மூலம் உலாவு"

#: src/iconlib/cmd/libraries.py:18
msgid "list discovered icon libraries"
msgstr "கண்டறியப்பட்ட சின்ன நூலகங்களைப் பட்டியலிடு"

#: src/iconlib/cmd/libraries.py:24
