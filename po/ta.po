#: src/iconlib.py:31
msgid ""
"Commands:\n"
"  search [pattern]   list matching icon names\n"
"  which [-a] name    print icon path(s)\n"
"  info name          print icon metadata\n"
"  pull [pattern]     copy icons into the project\n"
"  push [pattern]     upload icons (not implemented)\n"
"  browse [pattern]   open themestylebrowser\n"
"\n"
"Pattern: empty=all, exact name, glob, or /regex\n"
"Plain English words also match synonyms/inflections (scored).\n"
msgstr ""
"கட்டளைகள்:\n"
"  search [pattern]   பொருந்தும் சின்னம் பெயர்களை பட்டியலிடு\n"
"  which [-a] name    சின்னம் பாதையை அச்சிடு\n"
"  info name          சின்னம் மெட்டாடேட்டாவை அச்சிடு\n"
"  pull [pattern]     திட்டத்திற்கு சின்னங்களை நகலெடு\n"
"  push [pattern]     சின்னங்களை பதிவேற்று (செயல்படுத்தப்படவில்லை)\n"
"  browse [pattern]   themestylebrowser திற\n"
"\n"
"வடிவம்: வெற்று=அனைத்தும், துல்லியமான பெயர், glob, அல்லது /regex\n"
"சாதாரண ஆங்கில சொற்கள் ஒத்தசொல்/மாற்றங்களையும் பொருத்தும் (மதிப்பெண் உடன்).\n"

#: src/iconlib.py:47
msgid "Search and manage icons from installed icon libraries."
msgstr "நிறுவப்பட்ட சின்னம் நூலகங்களில் இருந்து சின்னங்களைத் தேடி நிர்வகியுங்கள்."

#: src/iconlib.py:57
msgid "add/restrict icon library (repeatable; prefix match)"
msgstr "சின்னம் நூலகத்தைச் சேர்/கட்டுப்படுத்து (மீண்டும் செய்யலாம்; முன்னொட்டு பொருத்தம்)"

#: src/iconlib.py:64
msgid "local assets directory for pull (relative to project-dir)"
msgstr "pull-க்கான உள்ளூர் சொத்து அடைவு (project-dir தொடர்பானது)"

#: src/iconlib.py:71
msgid "pull path schema (e.g. n, l/f/n, l/v/n)"
msgstr "pull பாதை திட்டம் (எ.கா. n, l/f/n, l/v/n)"

#: src/iconlib.py:80
msgid "map library name to local dirname"
msgstr "நூலகப் பெயரை உள்ளூர் அடைவுப் பெயருக்கு வரைபடமாக்கு"

#: src/iconlib.py:87
msgid "repeat for more verbose loggings"
msgstr "மேலும் விரிவான பதிவுகளுக்கு மீண்டும் செய்க"

#: src/iconlib.py:93
msgid "show less logging messages"
msgstr "குறைவான பதிவு செய்திகளைக் காட்டு"

#: src/iconlib.py:98
msgid "output version information and exit"
msgstr "பதிப்புத் தகவலை வெளியிட்டு வெளியேறு"

#: src/iconlib.py:103
msgid "find icons matching the query"
msgstr "வினவலுக்குப் பொருந்தும் சின்னங்களைக் கண்டுபிடி"

#: src/iconlib.py:109
msgid "long format including score"
msgstr "மதிப்பெண் உள்ளிட்ட நீண்ட வடிவம்"

#: src/iconlib.py:115
msgid "output names only (default)"
msgstr "பெயர்கள் மட்டும் வெளியீடு (இயல்புநிலை)"

#: src/iconlib.py:119
msgid "print icon paths for the name"
msgstr "பெயருக்கான சின்னம் பாதைகளை அச்சிடு"

#: src/iconlib.py:124
msgid "print all matching paths"
msgstr "பொருந்தும் அனைத்து பாதைகளையும் அச்சிடு"

#: src/iconlib.py:128
msgid "print icon info"
msgstr "சின்னம் தகவலை அச்சிடு"

#: src/iconlib.py:131
msgid "retrieve icons to the project"
msgstr "திட்டத்திற்கு சின்னங்களைப் பெறு"

#: src/iconlib.py:139
msgid "add a format (repeatable); default all"
msgstr "வடிவத்தைச் சேர் (மீண்டும் செய்யலாம்); இயல்புநிலை அனைத்தும்"

#: src/iconlib.py:148
msgid "add an image size or alias=size (repeatable)"
msgstr "பட அளவு அல்லது alias=size சேர் (மீண்டும் செய்யலாம்)"

#: src/iconlib.py:152
msgid "upload icons to a remote library"
msgstr "தொலை நூலகத்திற்கு சின்னங்களைப் பதிவேற்று"

#: src/iconlib.py:155
msgid "browse with themestylebrowser"
msgstr "themestylebrowser மூலம் உலாவு"

