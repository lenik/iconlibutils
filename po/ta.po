#: src/iconlib/cmd/index.py:147
msgid "output directory (default: .)"
msgstr "வெளியீட்டு அடைவு (இயல்பு: .)"

#: src/iconlib/cmd/index.py:153
msgid "library id embedded in the web page (default: first -l or basename)"
msgstr "வலைப்பக்கத்தில் உட்பொதிவு நூலக அடையாளம் (இயல்பு: முதல் -l அல்லது basename)"

#: src/iconlib/cmd/index.py:159
