#: src/iconlib/cmd/make.py:43
msgid "add an output format (repeatable; e.g. png, webp)"
msgstr "ஒரு வெளியீட்டு வடிவத்தைச் சேர் (மீண்டும் குறிக்கலாம்; எ.கா. png, webp)"

#: src/iconlib/cmd/make.py:49
msgid "local icon name(s) to expand"
msgstr "விரிவாக்க வேண்டிய உள்ளூர் சின்னப் பெயர்(கள்)"

#: src/iconlib/cmd/make.py:166
#, python-brace-format
msgid "Made {n} local variant file(s)"
msgstr "{n} உள்ளூர் மாறுபாட்டுக் கோப்பு(கள்) உருவாக்கப்பட்டன"
