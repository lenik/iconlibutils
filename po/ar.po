#: src/iconlib.py:31
msgid ""
"Commands:\n"
"  search [pattern]   list matching icon names\n"
"  which [-a] name    print icon path(s)\n"
"  info name          print icon metadata\n"
"  pull [pattern]     copy icons into the project\n"
"  push [pattern]     upload icons (not implemented)\n"
"  browse [pattern]   open themestylebrowser\n"
"\n"
"Pattern: empty=all, exact name, glob, or /regex\n"
"Plain English words also match synonyms/inflections (scored).\n"
msgstr ""
"الأوامر:\n"
"  search [pattern]   سرد أسماء الأيقونات المطابقة\n"
"  which [-a] name    طباعة مسار/مسارات الأيقونة\n"
"  info name          طباعة بيانات الأيقونة الوصفية\n"
"  pull [pattern]     نسخ الأيقونات إلى المشروع\n"
"  push [pattern]     رفع الأيقونات (غير مُنفَّذ)\n"
"  browse [pattern]   فتح themestylebrowser\n"
"\n"
"النمط: فارغ=الكل، اسم دقيق، glob، أو /تعبير_منتظم\n"
"الكلمات الإنجليزية العادية تطابق أيضاً المرادفات/التصريف (مع درجة).\n"

#: src/iconlib.py:47
msgid "Search and manage icons from installed icon libraries."
msgstr "البحث في مكتبات الأيقونات المثبتة وإدارتها."

#: src/iconlib.py:57
msgid "add/restrict icon library (repeatable; prefix match)"
msgstr "إضافة/تقييد مكتبة أيقونات (قابل للتكرار؛ مطابقة بادئة)"

#: src/iconlib.py:64
msgid "local assets directory for pull (relative to project-dir)"
msgstr "دليل الأصول المحلي لـ pull (نسبي إلى project-dir)"

#: src/iconlib.py:71
msgid "pull path schema (e.g. n, l/f/n, l/v/n)"
msgstr "مخطط مسار pull (مثل n، l/f/n، l/v/n)"

#: src/iconlib.py:80
msgid "map library name to local dirname"
msgstr "ربط اسم المكتبة باسم دليل محلي"

#: src/iconlib.py:87
msgid "repeat for more verbose loggings"
msgstr "كرر لمزيد من رسائل السجل التفصيلية"

#: src/iconlib.py:93
msgid "show less logging messages"
msgstr "إظهار رسائل سجل أقل"

#: src/iconlib.py:98
msgid "output version information and exit"
msgstr "إخراج معلومات الإصدار والخروج"

#: src/iconlib.py:103
msgid "find icons matching the query"
msgstr "العثور على أيقونات تطابق الاستعلام"

#: src/iconlib.py:109
msgid "long format including score"
msgstr "تنسيق طويل يتضمن الدرجة"

#: src/iconlib.py:115
msgid "output names only (default)"
msgstr "إخراج الأسماء فقط (افتراضي)"

#: src/iconlib.py:119
msgid "print icon paths for the name"
msgstr "طباعة مسارات الأيقونة للاسم"

#: src/iconlib.py:124
msgid "print all matching paths"
msgstr "طباعة كل المسارات المطابقة"

#: src/iconlib.py:128
msgid "print icon info"
msgstr "طباعة معلومات الأيقونة"

#: src/iconlib.py:131
msgid "retrieve icons to the project"
msgstr "جلب الأيقونات إلى المشروع"

#: src/iconlib.py:139
msgid "add a format (repeatable); default all"
msgstr "إضافة تنسيق (قابل للتكرار)؛ الافتراضي الكل"

#: src/iconlib.py:148
msgid "add an image size or alias=size (repeatable)"
msgstr "إضافة حجم صورة أو alias=size (قابل للتكرار)"

#: src/iconlib.py:152
msgid "upload icons to a remote library"
msgstr "رفع الأيقونات إلى مكتبة بعيدة"

#: src/iconlib.py:155
msgid "browse with themestylebrowser"
msgstr "التصفح باستخدام themestylebrowser"

