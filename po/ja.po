#: src/iconlib.py:31
msgid ""
"Commands:\n"
"  search [pattern]   list matching icon names\n"
"  which [-a] name    print icon path(s)\n"
"  info name          print icon metadata\n"
"  pull [pattern]     copy icons into the project\n"
"  push [pattern]     upload icons (not implemented)\n"
"  browse [pattern]   open themestylebrowser\n"
"\n"
"Pattern: empty=all, exact name, glob, or /regex\n"
"Plain English words also match synonyms/inflections (scored).\n"
msgstr ""
"コマンド:\n"
"  search [pattern]   一致するアイコン名を一覧表示\n"
"  which [-a] name    アイコンのパスを表示\n"
"  info name          アイコンのメタデータを表示\n"
"  pull [pattern]     プロジェクトにアイコンをコピー\n"
"  push [pattern]     アイコンをアップロード（未実装）\n"
"  browse [pattern]   themestylebrowser を開く\n"
"\n"
"パターン: 空=すべて、正確な名前、glob、または /regex\n"
"通常の英語単語は同義語・屈折形も照合します（スコア付き）。\n"

#: src/iconlib.py:47
msgid "Search and manage icons from installed icon libraries."
msgstr "インストール済みアイコンライブラリからアイコンを検索・管理します。"

#: src/iconlib.py:57
msgid "add/restrict icon library (repeatable; prefix match)"
msgstr "アイコンライブラリを追加/制限（繰り返し可；接頭辞一致）"

#: src/iconlib.py:64
msgid "local assets directory for pull (relative to project-dir)"
msgstr "pull 用のローカルアセットディレクトリ（project-dir 相対）"

#: src/iconlib.py:71
msgid "pull path schema (e.g. n, l/f/n, l/v/n)"
msgstr "pull のパススキーマ（例: n、l/f/n、l/v/n）"

#: src/iconlib.py:80
msgid "map library name to local dirname"
msgstr "ライブラリ名をローカルディレクトリ名に対応付ける"

#: src/iconlib.py:87
msgid "repeat for more verbose loggings"
msgstr "繰り返すとより詳細なログを出力"

#: src/iconlib.py:93
msgid "show less logging messages"
msgstr "ログメッセージを減らして表示"

#: src/iconlib.py:98
msgid "output version information and exit"
msgstr "バージョン情報を出力して終了"

#: src/iconlib.py:103
msgid "find icons matching the query"
msgstr "クエリに一致するアイコンを検索"

#: src/iconlib.py:109
msgid "long format including score"
msgstr "スコアを含む詳細形式"

#: src/iconlib.py:115
msgid "output names only (default)"
msgstr "名前のみ出力（デフォルト）"

#: src/iconlib.py:119
