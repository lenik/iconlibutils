#: src/iconlib.py:131
msgid "retrieve icons to the project"
msgstr "プロジェクトにアイコンを取得"

#: src/iconlib.py:139
msgid "add a format (repeatable); default all"
msgstr "形式を追加（繰り返し可）；既定はすべて"

#: src/iconlib.py:148
msgid "add an image size or alias=size (repeatable)"
msgstr "画像サイズまたは alias=size を追加（繰り返し可）"

#: src/iconlib.py:152
msgid "upload icons to a remote library"
msgstr "リモートライブラリにアイコンをアップロード"

#: src/iconlib.py:155
msgid "browse with themestylebrowser"
msgstr "themestylebrowser で閲覧"

