#: src/iconlib.py:31
msgid ""
"Commands:\n"
"  search [pattern]   list matching icon names\n"
"  which [-a] name    print icon path(s)\n"
"  info name          print icon metadata\n"
"  pull [pattern]     copy icons into the project\n"
"  push [pattern]     upload icons (not implemented)\n"
"  browse [pattern]   open themestylebrowser\n"
"\n"
"Pattern: empty=all, exact name, glob, or /regex\n"
"Plain English words also match synonyms/inflections (scored).\n"
msgstr ""
"Comandos:\n"
"  search [pattern]   listar nombres de iconos coincidentes\n"
"  which [-a] name    mostrar ruta(s) del icono\n"
"  info name          mostrar metadatos del icono\n"
"  pull [pattern]     copiar iconos al proyecto\n"
"  push [pattern]     subir iconos (no implementado)\n"
"  browse [pattern]   abrir themestylebrowser\n"
"\n"
"Patron: vacio=todos, nombre exacto, glob o /regex\n"
"Las palabras en ingles tambien coinciden con sinonimos/flexiones (con puntuacion).\n"

#: src/iconlib.py:47
msgid "Search and manage icons from installed icon libraries."
msgstr "Buscar y gestionar iconos de las bibliotecas de iconos instaladas."

#: src/iconlib.py:57
msgid "add/restrict icon library (repeatable; prefix match)"
msgstr "anadir/restringir biblioteca de iconos (repetible; coincidencia de prefijo)"

#: src/iconlib.py:64
msgid "local assets directory for pull (relative to project-dir)"
msgstr "directorio local de recursos para pull (relativo a project-dir)"

#: src/iconlib.py:71
msgid "pull path schema (e.g. n, l/f/n, l/v/n)"
msgstr "esquema de ruta para pull (p. ej. n, l/f/n, l/v/n)"

#: src/iconlib.py:80
msgid "map library name to local dirname"
msgstr "asignar el nombre de biblioteca a un directorio local"

#: src/iconlib.py:87
msgid "repeat for more verbose loggings"
msgstr "repetir para mensajes de registro mas detallados"

#: src/iconlib.py:93
msgid "show less logging messages"
msgstr "mostrar menos mensajes de registro"

#: src/iconlib.py:98
msgid "output version information and exit"
msgstr "mostrar informacion de version y salir"

#: src/iconlib.py:103
msgid "find icons matching the query"
msgstr "buscar iconos que coincidan con la consulta"

#: src/iconlib.py:109
msgid "long format including score"
msgstr "formato largo incluyendo la puntuacion"

#: src/iconlib.py:115
msgid "output names only (default)"
msgstr "mostrar solo nombres (predeterminado)"

#: src/iconlib.py:119
msgid "print icon paths for the name"
msgstr "mostrar las rutas del icono para el nombre"

#: src/iconlib.py:124
msgid "print all matching paths"
msgstr "mostrar todas las rutas coincidentes"

#: src/iconlib.py:128
msgid "print icon info"
msgstr "mostrar informacion del icono"

#: src/iconlib.py:131
msgid "retrieve icons to the project"
msgstr "obtener iconos al proyecto"

#: src/iconlib.py:139
msgid "add a format (repeatable); default all"
msgstr "anadir un formato (repetible); predeterminado: todos"

#: src/iconlib.py:148
msgid "add an image size or alias=size (repeatable)"
msgstr "anadir un tamano de imagen o alias=size (repetible)"

#: src/iconlib.py:152
msgid "upload icons to a remote library"
msgstr "subir iconos a una biblioteca remota"

#: src/iconlib.py:155
msgid "browse with themestylebrowser"
msgstr "explorar con themestylebrowser"

