#: src/iconlib.py:31
msgid ""
"Commands:\n"
"  search [pattern]   list matching icon names\n"
"  which [-a] name    print icon path(s)\n"
"  info name          print icon metadata\n"
"  pull [pattern]     copy icons into the project\n"
"  push [pattern]     upload icons (not implemented)\n"
"  browse [pattern]   open themestylebrowser\n"
"\n"
"Pattern: empty=all, exact name, glob, or /regex\n"
"Plain English words also match synonyms/inflections (scored).\n"
msgstr ""
"คำสั่ง:\n"
"  search [pattern]   แสดงรายชื่อไอคอนที่ตรงกัน\n"
"  which [-a] name    พิมพ์พาธของไอคอน\n"
"  info name          พิมพ์เมทาดาทาของไอคอน\n"
"  pull [pattern]     คัดลอกไอคอนเข้าโปรเจกต์\n"
"  push [pattern]     อัปโหลดไอคอน (ยังไม่ทำ)\n"
"  browse [pattern]   เปิด themestylebrowser\n"
"\n"
"รูปแบบ: ว่าง=ทั้งหมด ชื่อตรง glob หรือ /regex\n"
"คำภาษาอังกฤษธรรมดายังจับคู่คำพ้อง/รูปผัน (มีคะแนน)\n"

#: src/iconlib.py:47
msgid "Search and manage icons from installed icon libraries."
msgstr "ค้นหาและจัดการไอคอนจากไลบรารีไอคอนที่ติดตั้งไว้"

#: src/iconlib.py:57
msgid "add/restrict icon library (repeatable; prefix match)"
msgstr "เพิ่ม/จำกัดไลบรารีไอคอน (ทำซ้ำได้; จับคู่คำนำหน้า)"

#: src/iconlib.py:64
msgid "local assets directory for pull (relative to project-dir)"
msgstr "ไดเรกทอรีสินทรัพย์ในเครื่องสำหรับ pull (สัมพัทธ์กับ project-dir)"

#: src/iconlib.py:71
msgid "pull path schema (e.g. n, l/f/n, l/v/n)"
msgstr "สคีมาพาธสำหรับ pull (เช่น n, l/f/n, l/v/n)"

#: src/iconlib.py:80
msgid "map library name to local dirname"
msgstr "จับคู่ชื่อไลบรารีกับชื่อไดเรกทอรีในเครื่อง"

#: src/iconlib.py:87
msgid "repeat for more verbose loggings"
msgstr "ทำซ้ำเพื่อบันทึกรายละเอียดมากขึ้น"

#: src/iconlib.py:93
msgid "show less logging messages"
msgstr "แสดงข้อความบันทึกน้อยลง"

#: src/iconlib.py:98
msgid "output version information and exit"
msgstr "แสดงข้อมูลเวอร์ชันแล้วออก"

#: src/iconlib.py:103
msgid "find icons matching the query"
msgstr "ค้นหาไอคอนที่ตรงกับคำค้น"

#: src/iconlib.py:109
msgid "long format including score"
msgstr "รูปแบบยาวรวมคะแนน"

#: src/iconlib.py:115
msgid "output names only (default)"
msgstr "แสดงเฉพาะชื่อ (ค่าเริ่มต้น)"

#: src/iconlib.py:119
msgid "print icon paths for the name"
msgstr "พิมพ์พาธไอคอนสำหรับชื่อ"

#: src/iconlib.py:124
msgid "print all matching paths"
msgstr "พิมพ์พาธที่ตรงกันทั้งหมด"

#: src/iconlib.py:128
msgid "print icon info"
msgstr "พิมพ์ข้อมูลไอคอน"

#: src/iconlib.py:131
msgid "retrieve icons to the project"
msgstr "ดึงไอคอนเข้าโปรเจกต์"

#: src/iconlib.py:139
msgid "add a format (repeatable); default all"
msgstr "เพิ่มรูปแบบ (ทำซ้ำได้); ค่าเริ่มต้นทั้งหมด"

#: src/iconlib.py:148
msgid "add an image size or alias=size (repeatable)"
msgstr "เพิ่มขนาดภาพหรือ alias=size (ทำซ้ำได้)"

#: src/iconlib.py:152
msgid "upload icons to a remote library"
msgstr "อัปโหลดไอคอนไปยังไลบรารีระยะไกล"

#: src/iconlib.py:155
