#: src/iconlib.py:31
msgid ""
"Commands:\n"
"  search [pattern]   list matching icon names\n"
"  which [-a] name    print icon path(s)\n"
"  info name          print icon metadata\n"
"  pull [pattern]     copy icons into the project\n"
"  push [pattern]     upload icons (not implemented)\n"
"  browse [pattern]   open themestylebrowser\n"
"\n"
"Pattern: empty=all, exact name, glob, or /regex\n"
"Plain English words also match synonyms/inflections (scored).\n"
msgstr ""
"Comandos:\n"
"  search [pattern]   listar nomes de icones correspondentes\n"
"  which [-a] name    imprimir caminho(s) do icone\n"
"  info name          imprimir metadados do icone\n"
"  pull [pattern]     copiar icones para o projeto\n"
"  push [pattern]     enviar icones (nao implementado)\n"
"  browse [pattern]   abrir themestylebrowser\n"
"\n"
"Padrao: vazio=todos, nome exato, glob ou /regex\n"
"Palavras em ingles tambem correspondem a sinonimos/flexoes (com pontuacao).\n"

#: src/iconlib.py:47
msgid "Search and manage icons from installed icon libraries."
msgstr "Pesquisar e gerir icones das bibliotecas de icones instaladas."

#: src/iconlib.py:57
msgid "add/restrict icon library (repeatable; prefix match)"
msgstr "adicionar/restringir biblioteca de icones (repetivel; correspondencia de prefixo)"

#: src/iconlib.py:64
msgid "local assets directory for pull (relative to project-dir)"
msgstr "diretorio local de recursos para pull (relativo a project-dir)"

#: src/iconlib.py:71
msgid "pull path schema (e.g. n, l/f/n, l/v/n)"
msgstr "esquema de caminho para pull (ex.: n, l/f/n, l/v/n)"

#: src/iconlib.py:80
msgid "map library name to local dirname"
msgstr "mapear o nome da biblioteca para um diretorio local"

#: src/iconlib.py:87
msgid "repeat for more verbose loggings"
msgstr "repetir para registos mais detalhados"

#: src/iconlib.py:93
msgid "show less logging messages"
msgstr "mostrar menos mensagens de registo"

#: src/iconlib.py:98
msgid "output version information and exit"
msgstr "mostrar informacao de versao e sair"

#: src/iconlib.py:103
msgid "find icons matching the query"
msgstr "encontrar icones que correspondam a consulta"

#: src/iconlib.py:109
msgid "long format including score"
msgstr "formato longo incluindo pontuacao"

#: src/iconlib.py:115
msgid "output names only (default)"
msgstr "mostrar apenas nomes (padrao)"

#: src/iconlib.py:119
msgid "print icon paths for the name"
msgstr "imprimir caminhos do icone para o nome"

#: src/iconlib.py:124
msgid "print all matching paths"
msgstr "imprimir todos os caminhos correspondentes"

#: src/iconlib.py:128
msgid "print icon info"
msgstr "imprimir informacao do icone"

#: src/iconlib.py:131
msgid "retrieve icons to the project"
msgstr "obter icones para o projeto"

#: src/iconlib.py:139
msgid "add a format (repeatable); default all"
msgstr "adicionar um formato (repetivel); padrao: todos"

#: src/iconlib.py:148
msgid "add an image size or alias=size (repeatable)"
msgstr "adicionar um tamanho de imagem ou alias=size (repetivel)"

#: src/iconlib.py:152
msgid "upload icons to a remote library"
msgstr "enviar icones para uma biblioteca remota"

#: src/iconlib.py:155
