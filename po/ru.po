#: src/iconlib.py:31
msgid ""
"Commands:\n"
"  search [pattern]   list matching icon names\n"
"  which [-a] name    print icon path(s)\n"
"  info name          print icon metadata\n"
"  pull [pattern]     copy icons into the project\n"
"  push [pattern]     upload icons (not implemented)\n"
"  browse [pattern]   open themestylebrowser\n"
"\n"
"Pattern: empty=all, exact name, glob, or /regex\n"
"Plain English words also match synonyms/inflections (scored).\n"
msgstr ""
"Команды:\n"
"  search [pattern]   список подходящих имён значков\n"
"  which [-a] name    вывести путь(и) значка\n"
"  info name          вывести метаданные значка\n"
"  pull [pattern]     скопировать значки в проект\n"
"  push [pattern]     загрузить значки (не реализовано)\n"
"  browse [pattern]   открыть themestylebrowser\n"
"\n"
"Шаблон: пусто=все, точное имя, glob или /regex\n"
"Обычные английские слова также находят синонимы/формы (со счётом).\n"

#: src/iconlib.py:47
msgid "Search and manage icons from installed icon libraries."
msgstr "Поиск и управление значками из установленных библиотек значков."

#: src/iconlib.py:57
msgid "add/restrict icon library (repeatable; prefix match)"
msgstr "добавить/ограничить библиотеку значков (повторяемо; совпадение префикса)"

#: src/iconlib.py:64
msgid "local assets directory for pull (relative to project-dir)"
msgstr "локальный каталог ресурсов для pull (относительно project-dir)"

#: src/iconlib.py:71
msgid "pull path schema (e.g. n, l/f/n, l/v/n)"
msgstr "схема пути для pull (напр. n, l/f/n, l/v/n)"

#: src/iconlib.py:80
msgid "map library name to local dirname"
msgstr "сопоставить имя библиотеки с локальным каталогом"

#: src/iconlib.py:87
msgid "repeat for more verbose loggings"
msgstr "повторить для более подробных сообщений журнала"

#: src/iconlib.py:93
msgid "show less logging messages"
msgstr "показывать меньше сообщений журнала"

#: src/iconlib.py:98
msgid "output version information and exit"
msgstr "вывести сведения о версии и выйти"

#: src/iconlib.py:103
msgid "find icons matching the query"
msgstr "найти значки, соответствующие запросу"

#: src/iconlib.py:109
msgid "long format including score"
msgstr "длинный формат со счётом"

#: src/iconlib.py:115
msgid "output names only (default)"
msgstr "выводить только имена (по умолчанию)"

#: src/iconlib.py:119
msgid "print icon paths for the name"
msgstr "вывести пути значка для имени"

#: src/iconlib.py:124
msgid "print all matching paths"
msgstr "вывести все подходящие пути"

#: src/iconlib.py:128
msgid "print icon info"
msgstr "вывести сведения о значке"

#: src/iconlib.py:131
msgid "retrieve icons to the project"
msgstr "получить значки в проект"

#: src/iconlib.py:139
msgid "add a format (repeatable); default all"
msgstr "добавить формат (повторяемо); по умолчанию все"

#: src/iconlib.py:148
msgid "add an image size or alias=size (repeatable)"
msgstr "добавить размер изображения или alias=size (повторяемо)"

#: src/iconlib.py:152
msgid "upload icons to a remote library"
msgstr "загрузить значки в удалённую библиотеку"

#: src/iconlib.py:155
msgid "browse with themestylebrowser"
msgstr "просмотр через themestylebrowser"

