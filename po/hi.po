#: src/iconlib.py:31
msgid ""
"Commands:\n"
"  search [pattern]   list matching icon names\n"
"  which [-a] name    print icon path(s)\n"
"  info name          print icon metadata\n"
"  pull [pattern]     copy icons into the project\n"
"  push [pattern]     upload icons (not implemented)\n"
"  browse [pattern]   open themestylebrowser\n"
"\n"
"Pattern: empty=all, exact name, glob, or /regex\n"
"Plain English words also match synonyms/inflections (scored).\n"
msgstr ""
"कमांड:\n"
"  search [pattern]   मेल खाते आइकन नाम सूचीबद्ध करें\n"
"  which [-a] name    आइकन पथ दिखाएँ\n"
"  info name          आइकन मेटाडेटा दिखाएँ\n"
"  pull [pattern]     प्रोजेक्ट में आइकन कॉपी करें\n"
"  push [pattern]     आइकन अपलोड करें (अभी लागू नहीं)\n"
"  browse [pattern]   themestylebrowser खोलें\n"
"\n"
"पैटर्न: खाली=सभी, सटीक नाम, glob, या /regex\n"
"साधारण अंग्रेज़ी शब्द पर्याय/रूप भी मिलाते हैं (स्कोर सहित)।\n"

#: src/iconlib.py:47
msgid "Search and manage icons from installed icon libraries."
msgstr "स्थापित आइकन लाइब्रेरी से आइकन खोजें और प्रबंधित करें।"

#: src/iconlib.py:57
msgid "add/restrict icon library (repeatable; prefix match)"
msgstr "आइकन लाइब्रेरी जोड़ें/सीमित करें (दोहराया जा सकता है; उपसर्ग मिलान)"

#: src/iconlib.py:64
msgid "local assets directory for pull (relative to project-dir)"
msgstr "pull के लिए स्थानीय एसेट निर्देशिका (project-dir के सापेक्ष)"

#: src/iconlib.py:71
msgid "pull path schema (e.g. n, l/f/n, l/v/n)"
msgstr "pull पथ स्कीमा (जैसे n, l/f/n, l/v/n)"

#: src/iconlib.py:80
msgid "map library name to local dirname"
msgstr "लाइब्रेरी नाम को स्थानीय निर्देशिका नाम से मैप करें"

#: src/iconlib.py:87
msgid "repeat for more verbose loggings"
msgstr "अधिक विस्तृत लॉग के लिए दोहराएँ"

#: src/iconlib.py:93
msgid "show less logging messages"
msgstr "कम लॉग संदेश दिखाएँ"

#: src/iconlib.py:98
msgid "output version information and exit"
msgstr "संस्करण जानकारी दिखाकर बाहर निकलें"

#: src/iconlib.py:103
msgid "find icons matching the query"
msgstr "क्वेरी से मेल खाते आइकन खोजें"

#: src/iconlib.py:109
msgid "long format including score"
msgstr "स्कोर सहित लंबा प्रारूप"

#: src/iconlib.py:115
msgid "output names only (default)"
msgstr "केवल नाम दिखाएँ (डिफ़ॉल्ट)"

#: src/iconlib.py:119
msgid "print icon paths for the name"
msgstr "नाम के लिए आइकन पथ दिखाएँ"

#: src/iconlib.py:124
msgid "print all matching paths"
msgstr "सभी मेल खाते पथ दिखाएँ"

#: src/iconlib.py:128
msgid "print icon info"
msgstr "आइकन जानकारी दिखाएँ"

#: src/iconlib.py:131
msgid "retrieve icons to the project"
msgstr "प्रोजेक्ट में आइकन लाएँ"

#: src/iconlib.py:139
msgid "add a format (repeatable); default all"
msgstr "एक प्रारूप जोड़ें (दोहराया जा सकता है); डिफ़ॉल्ट सभी"

#: src/iconlib.py:148
msgid "add an image size or alias=size (repeatable)"
msgstr "छवि आकार या alias=size जोड़ें (दोहराया जा सकता है)"

#: src/iconlib.py:152
msgid "upload icons to a remote library"
msgstr "दूरस्थ लाइब्रेरी में आइकन अपलोड करें"

#: src/iconlib.py:155
msgid "browse with themestylebrowser"
msgstr "themestylebrowser से ब्राउज़ करें"

