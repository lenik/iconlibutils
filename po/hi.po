msgstr "CLIP से पहले FAISS कैनवास आकार (डिफ़ॉल्ट: 300x300)"

#: src/iconlib/cmd/index.py:147
msgid "output directory (default: .)"
msgstr "आउटपुट निर्देशिका (डिफ़ॉल्ट: .)"

#: src/iconlib/cmd/index.py:153
