msgstr "वेब पृष्ठ पर दिखाया गया लाइसेंस लेबल"

#: src/iconlib/cmd/index.py:171
msgid "homepage URL shown in the web page"
msgstr "वेब पृष्ठ पर दिखाया गया होमपेज URL"

#: src/iconlib/cmd/index.py:179
msgid "icon root to scan (repeatable; default: selected library paths)"
msgstr "स्कैन करने हेतु आइकन रूट (दोहराया जा सकता है; डिफ़ॉल्ट: चयनित पुस्तकालय पथ)"

#: src/iconlib/cmd/index.py:184
msgid "URL prefix for SVG hrefs in the web preview (default: ..)"
msgstr "वेब पूर्वावलोकन में SVG href हेतु URL उपसर्ग (डिफ़ॉल्ट: ..)"

#: src/iconlib/cmd/index.py:190
msgid "web template directory (default: <pkgdatadir>/index)"
msgstr "वेब टेम्पलेट निर्देशिका (डिफ़ॉल्ट: <pkgdatadir>/index)"

#: src/iconlib/cmd/index.py:196
msgid "limit number of icons for web preview (0 = unlimited)"
msgstr "वेब पूर्वावलोकन हेतु आइकन संख्या सीमित करें (0 = असीमित)"

