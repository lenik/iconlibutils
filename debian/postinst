#!/bin/sh
set -e

# Libraries self-register by installing a drop-in file:
#   /usr/share/iconlibutils/library/<name>
# iconlib discovers them by scanning that directory — no path registry seeding.

case "$1" in
    configure)
        mkdir -p /usr/share/iconlibutils/library
        ;;
esac

#DEBHELPER#

exit 0
