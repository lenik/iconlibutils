#!/bin/sh
set -e

# Known icon libraries from /home/cursor/icon packaging trees.
# NAME|SHARE_DIR  (SHARE_DIR relative to /usr/share)
KNOWN_LIBS='
flowbite|flowbite-icons
heroicons|heroicons
iconify|iconify
lucide|lucide
materialdesignicons|materialdesignicons
openmoji|openmoji
phosphor-icons|phosphor-icons
streamline-vectors|streamline-vectors
tabler-icons|tabler-icons
'

PATH_FILE=/etc/iconlibutils/path
MARKER_BEGIN='# BEGIN iconlibutils-managed'
MARKER_END='# END iconlibutils-managed'

write_managed_block() {
    echo "$MARKER_BEGIN"
    echo "# Generated by iconlibutils postinst; do not edit this block."
    echo "$KNOWN_LIBS" | while IFS='|' read -r name share; do
        [ -n "$name" ] || continue
        dir="/usr/share/$share"
        if [ -d "$dir" ]; then
            printf 'auto %s %s\n' "$name" "$dir"
        fi
    done
    echo "$MARKER_END"
}

case "$1" in
    configure)
        mkdir -p /etc/iconlibutils
        tmp=$(mktemp)
        if [ -f "$PATH_FILE" ]; then
            # Keep user lines outside the managed block.
            awk -v b="$MARKER_BEGIN" -v e="$MARKER_END" '
                $0 == b {skip=1; next}
                $0 == e {skip=0; next}
                !skip {print}
            ' "$PATH_FILE" > "$tmp"
        else
            : > "$tmp"
        fi
        {
            cat "$tmp"
            echo
            write_managed_block
        } > "$PATH_FILE"
        rm -f "$tmp"
        ;;
esac

#DEBHELPER#

exit 0
